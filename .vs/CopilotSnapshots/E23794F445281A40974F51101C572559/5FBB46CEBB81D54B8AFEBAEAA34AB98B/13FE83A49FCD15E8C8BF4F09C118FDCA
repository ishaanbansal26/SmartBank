@using SmartBank.MVC.ViewModel
@model List<AccountWithTransaction>

<h2>Your Accounts</h2>

<form method="post" asp-action="Create">
    <button class="btn btn-primary mb-3">Create New Account</button>
</form>

@foreach (var acc in Model)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>Account Number:</strong> @acc.Account.AccountNumber
            <span class="float-end"><strong>Balance:</strong> @acc.Account.Balance</span>
        </div>
        <div class="card-body">
            <div class="mb-2">
                <!-- Deposit -->
                <form method="post" asp-action="Deposit" style="display:inline-block; margin-right:5px;">
                    <input type="hidden" name="accountId" value="@acc.Account.Id" />
                    <input type="number" name="amount" placeholder="Amount" class="form-control d-inline-block" style="width:120px;" />
                    <button class="btn btn-success btn-sm">Deposit</button>
                </form>

                <!-- Withdraw -->
                <form method="post" asp-action="Withdraw" style="display:inline-block; margin-right:5px;">
                    <input type="hidden" name="accountId" value="@acc.Account.Id" />
                    <input type="number" name="amount" placeholder="Amount" class="form-control d-inline-block" style="width:120px;" />
                    <button class="btn btn-warning btn-sm">Withdraw</button>
                </form>

                <!-- Delete -->
                <form method="post" asp-action="Delete" style="display:inline-block;">
                    <input type="hidden" name="id" value="@acc.Account.Id" />
                    <button class="btn btn-danger btn-sm">Delete</button>
                </form>
            </div>

            <!-- Transactions Table -->
            <h6>Transactions</h6>
            @if (acc.Transactions != null && acc.Transactions.Any())
            {
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Amount</th>
                            @* <th>Description</th> *@
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in acc.Transactions)
                        {
                            <tr>
                                <td>@tx.Type</td>
                                <td>@tx.Amount</td>
                                @* <td>@tx.Description</td> *@
                                <td>@tx.Date.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No transactions yet.</p>
            }
        </div>
    </div>
}