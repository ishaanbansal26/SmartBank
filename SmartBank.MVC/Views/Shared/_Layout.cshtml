<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartBank</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                margin: 0;
                font-family: 'Segoe UI', sans-serif;
                background: linear-gradient(135deg, #eef2ff, #f8fafc);
            }

            /* Navbar */
            .custom-navbar {
                backdrop-filter: blur(10px);
                background: rgba(255, 255, 255, 0.7);
                box-shadow: 0 4px 20px rgba(0,0,0,0.05);
                border-bottom: 1px solid rgba(255,255,255,0.3);
            }

            .navbar-brand {
                font-weight: 700;
                font-size: 1.4rem;
                color: #4f46e5 !important;
            }

            .nav-link {
                font-weight: 500;
                color: #374151 !important;
                transition: 0.2s;
            }

                .nav-link:hover {
                    color: #4f46e5 !important;
                }

            /* Profile Avatar */
            .profile-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: linear-gradient(135deg, #6366f1, #4f46e5);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                cursor: pointer;
            }

            /* Container spacing */
            .main-container {
                min-height: calc(100vh - 140px);
                padding-top: 20px;
            }

            /* Footer */
            footer {
                backdrop-filter: blur(10px);
                background: rgba(255, 255, 255, 0.6);
                border-top: 1px solid rgba(255,255,255,0.3);
                padding: 15px 0;
                text-align: center;
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg custom-navbar sticky-top">
            <div class="container-fluid px-4">

                <!-- Logo -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    💳 SmartBank
                </a>

                <!-- Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- LEFT -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>

                    <!-- RIGHT -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">

                        @if (Context.Session.GetString("JWT") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Accounts/Index">Accounts</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Feedback">Feedback</a>
                            </li>

                            <!-- Profile Dropdown -->
                            <li class="nav-item dropdown">
                                <div class="profile-avatar dropdown-toggle"
                                     data-bs-toggle="dropdown">
                                    U
                                </div>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                    <li class="dropdown-item-text fw-semibold">
                                        👤 User Profile
                                    </li>
                                    <li><hr class="dropdown-divider"></li>

                                    @* <li>
                                        <a class="dropdown-item" href="#">
                                            ⚙️ Settings
                                        </a>
                                    </li> *@

                                    <li>
                                        <a class="dropdown-item text-danger"
                                               asp-controller="Auth" asp-action="Logout">
                                            🚪 Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Auth/Login">Login</a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary px-3" href="/Auth/Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN -->
    <div class="container main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container text-muted">
            &copy; 2026 - <strong>SmartBank</strong> •
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">
                Privacy Policy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>